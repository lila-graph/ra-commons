# AI Engineering Bootcamp Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM API Keys
# ============================================================================

# OpenAI (required for most modules)
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=  # Optional

# Anthropic Claude (alternative to OpenAI)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# LangSmith (Evaluation and Tracing)
# ============================================================================

# Sign up at https://smith.langchain.com
LANGSMITH_API_KEY=ls_...
LANGSMITH_PROJECT=bootcamp-student-name
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================================
# Vector Database (Qdrant)
# ============================================================================

# Option 1: Local Qdrant (docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Option 2: Qdrant Cloud
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-api-key

# ============================================================================
# Graph Database (Neo4j)
# ============================================================================

# Option 1: Local Neo4j (docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bootcamp123

# Option 2: Neo4j Aura
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# ============================================================================
# Graphiti Configuration
# ============================================================================

GRAPHITI_STORAGE_TYPE=neo4j  # or 'falkordb'
GRAPHITI_LLM_PROVIDER=openai  # or 'anthropic'

# ============================================================================
# Prefect Configuration
# ============================================================================

PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_LOGGING_LEVEL=INFO

# ============================================================================
# Application Settings
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # or 'pretty'

# Data directories
DATA_DIR=./data
CACHE_DIR=./.cache
OUTPUT_DIR=./outputs

# ============================================================================
# Embedding Models
# ============================================================================

# Default embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Alternative: sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# ============================================================================
# Module-Specific Settings
# ============================================================================

# Chunking defaults (Module 01)
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50

# Retrieval defaults (Module 02)
TOP_K_RESULTS=10
RERANK_TOP_K=5

# Agent defaults (Module 04)
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# ============================================================================
# Optional: External Tools
# ============================================================================

# Google Search (for agent tools)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Tavily Search API
TAVILY_API_KEY=

# ============================================================================
# Development/Testing
# ============================================================================

# Use smaller/faster models for testing
TEST_MODE=false
TEST_LLM_MODEL=gpt-3.5-turbo  # Cheaper for testing

# Enable debug mode
DEBUG=false

# ============================================================================
# Security Notes
# ============================================================================
# NEVER commit this file with real API keys!
# Add .env to .gitignore
# Use environment-specific .env files (.env.dev, .env.prod)
# Consider using secret management tools (AWS Secrets Manager, etc.)
